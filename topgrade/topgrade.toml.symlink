# topgrade configuration
# See https://github.com/topgrade-rs/topgrade for the full set of options.

[misc]
# Docker/Rancher Desktop is usually not running, so the containers step
# fails to connect to the daemon and prompts to retry. Ignore that failure
# so unattended runs continue; container images still upgrade when the
# daemon happens to be up.
ignore_failures = ["containers"]

# The `gem` step runs `gem update --user-install`, which installs newer
# copies of Ruby's default gems (json, psych, openssl, ...) into
# ~/.gem/ruby/<abi>/. Their native extensions link against the exact
# libruby of the ruby that built them, but the directory is keyed by ABI
# version (3.4.0), so it is shared by every 3.4.x install. When mise
# replaces ruby 3.4.9 with 3.4.10 the old .bundle files dangle, and
# because RubyGems swallows the resulting LoadError every gem subcommand
# dies with a bogus "uninitialized constant Gem::Commands::XCommand".
# mise-managed rubies ship current default gems anyway.
#
# The separate `ruby_gems` step (`gem update --system`) stays enabled: it
# upgrades RubyGems inside the mise install dir and has no such problem.
disable = ["gem"]

# Never prompt "Retry? (y/N)" on a failed step; keep runs non-interactive.
no_retry = true

# Clean up temporary/old files at the end of a run.
cleanup = true

[commands]
# Re-fetch the skills.sh skills shared by every coding agent.
"agent skills" = "python3 ~/.dotfiles/agents/install.py --update"

[brew]
# Run `brew autoremove` after upgrading formulae to drop orphaned deps.
autoremove = true
